{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=EventManagementDb_Dev;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true",
    "AzureStorage": "UseDevelopmentStorage=true"
  },
  "JwtSettings": {
    "Secret": "development-jwt-secret-key-that-is-at-least-256-bits-long-for-development-only",
    "Issuer": "EventManagementSystem.Development",
    "Audience": "EventManagementSystem.Development.Users",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryInDays": 30
  },
  "Database": {
    "DetailedErrors": true,
    "EnableSensitiveDataLogging": true
  },
  "AzureStorage": {
    "ContainerName": "event-images-dev"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.SignalR": "Debug",
      "Microsoft.AspNetCore.Http.Connections": "Debug"
    }
  }
}